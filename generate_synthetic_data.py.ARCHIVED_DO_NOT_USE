# Generate 40 raw documents: 8 per topic.
for topic_name, facts in topics.items():
    for i in range(8):
        selected = facts[i : i + 5]
        lines = [
            f"# {topic_name.title()} Document {i + 1:02d}",
            "=" * (len(topic_name) + 18),
            "",
            f"This synthetic document covers {topic_name}.",
            "",
        ]
        for fact in selected:
            lines.append(f"- {fact}")
        lines.extend(["", "Summary: This is placeholder synthetic content for knowledge base testing."])
        content = "\n".join(lines)
        filename = RAW_DIR / f"{topic_name}_{i + 1:02d}.txt"
        filename.write_text(content, encoding="utf-8")

print(f"Created {len(list(RAW_DIR.glob('*.txt')))} raw documents")

# Generate 15 contradiction pairs.
pair_count = 15
all_contradictions = []
random.seed(42)

for pair in range(1, pair_count + 1):
    topic_name = random.choice(list(topics.keys()))
    facts = topics[topic_name]
    numeric_fact = random.choice(facts)
    year = None
    for token in numeric_fact.split():
        if token.replace(",", "").replace(".", "").isdigit():
            year = int(token.replace(",", "").replace(".", ""))
            break
    if year is None:
        continue

    offset = random.choice([5, 10, -5, -10])
    doc1 = {
        "id": f"{topic_name}_contr_{pair * 2 - 1:03d}",
        "text": numeric_fact.replace(str(year), str(year - offset)),
        "source": "synthetic_contradiction",
        "label": f"contradicts:{topic_name}_contr_{pair * 2:03d}",
        "publication_date": "2023-01-01",
    }
    doc2 = {
        "id": f"{topic_name}_contr_{pair * 2:03d}",
        "text": numeric_fact.replace(str(year), str(year + offset)),
        "source": "synthetic_contradiction",
        "label": f"contradicts:{topic_name}_contr_{pair * 2 - 1:03d}",
        "publication_date": "2024-01-01",
    }
    all_contradictions.extend([doc1, doc2])

    filename = CONTR_DIR / f"contradictions_{pair:02d}.jsonl"
    with filename.open("w", encoding="utf-8") as f:
        f.write(json.dumps(doc1, ensure_ascii=False) + "\n")
        f.write(json.dumps(doc2, ensure_ascii=False) + "\n")

print(f"Created {len(all_contradictions)} contradiction documents ({pair_count} pairs)")

